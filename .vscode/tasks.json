{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: dev server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "windows": {
        "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe"
      },
      "linux": { "command": "${workspaceFolder}/backend/.venv/bin/python" },
      "osx": { "command": "${workspaceFolder}/backend/.venv/bin/python" },
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev", "clear": true }
    },
    {
      "label": "frontend: dev server",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "group": "dev", "clear": true }
    },
    {
      "label": "▶ Run All (backend + frontend)",
      "dependsOn": ["backend: dev server", "frontend: dev server"],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "backend: run tests",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "linux": { "command": "${workspaceFolder}/backend/.venv/bin/python" },
      "osx": { "command": "${workspaceFolder}/backend/.venv/bin/python" },
      "args": ["-m", "tests.test_core"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "train: local exercise pipeline",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "linux": { "command": "${workspaceFolder}/backend/.venv/bin/python" },
      "osx": { "command": "${workspaceFolder}/backend/.venv/bin/python" },
      "args": ["scripts/train_local.py", "--datasets", "./datasets"],
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "frontend: production build",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "problemMatcher": []
    }
  ]
}
