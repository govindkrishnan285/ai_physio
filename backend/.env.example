# Copy to .env and adjust.
DATABASE_URL=postgresql+psycopg://physio:physio@localhost:5432/physio
DATA_DIR=./data
CORS_ORIGINS=http://localhost:3000
# Optional: cap how many frames per video are pose-processed (0 = all).
MAX_FRAMES_PER_VIDEO=900
# Enable the TensorFlow autoencoder layer (requires tensorflow installed).
ENABLE_TF=false
